        RowBox[{"x", ",", "\"\<z\>\""}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", " ", "Thick"}], "   ", ",", 
      RowBox[{"ImageSize", "\[Rule]", "500"}], " ", ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<t=\>\"", ",", "t"}], "}"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], "     "}]}], "Input",
