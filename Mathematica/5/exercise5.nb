 RowBox[{
  RowBox[{"pde", "=", "  ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"U", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "\[Equal]", " ", 
    RowBox[{"D", "[", 
