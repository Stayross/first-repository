Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "\[CapitalSigma]\:03cd\[Mu]\[CurlyPhi]\[Omega]\[Nu]\[Alpha]", " ", 
     "\[Mu]\[CurlyEpsilon]", " ", "\[Tau]\[Omicron]\[Upsilon]\[FinalSigma]", 
     " ", "\[Pi]\[Alpha]\[Rho]\[Alpha]\[Pi]\:03ac\[Nu]\[Omega]", " ", 
     "\[Upsilon]\[Pi]\[Omicron]\[Lambda]\[Omicron]\[Gamma]\[Iota]\[Sigma]\[Mu]\
\[Omicron]\:03cd\[FinalSigma]"}], ",", " ", 
    RowBox[{
    "\[Alpha]\[Pi]\[Lambda]\[Omicron]\[Pi]\[Omicron]\[Iota]\:03ce\[Nu]\[Tau]\
\[Alpha]\[FinalSigma]", " ", "\[Tau]\[Omicron]\[Upsilon]\[FinalSigma]", " ", 
     "\[Sigma]\[Upsilon]\[Nu]\[Tau]\[CurlyEpsilon]\[Lambda]\[CurlyEpsilon]\
\[Sigma]\[Tau]\:03ad\[FinalSigma]", " ", 
     SubscriptBox["d", "n"], " ", 
     RowBox[{
     "\:03ad\[Chi]\[Omicron]\[Upsilon]\[Mu]\[CurlyEpsilon]", ":"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<\[CapitalGamma]\[Iota]\[Alpha] \[Alpha]=3\>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<\[CapitalOmicron]\[Iota] \
\[Sigma]\[Upsilon]\[Nu]\[Tau]\[CurlyEpsilon]\[Lambda]\[CurlyEpsilon]\[Sigma]\
\[Tau]\:03ad\[FinalSigma] \!\(TraditionalForm\`\*SubscriptBox[\(d\), \(n\)]\) \
= \>\"", ",", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"n", ",", "3"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{"n", "\[Rule]", " ", 
          RowBox[{
           RowBox[{"2", "k"}], "+", "1"}]}], "}"}]}], " ", ",", 
       RowBox[{"k", " ", "\[Element]", "Integers"}]}], "]"}], ",", 
     "\"\<   ,n\[GreaterEqual]1 \[Kappa]\[Alpha]\[Iota] n \
\[Pi]\[CurlyEpsilon]\[Rho]\[Rho]\[Iota]\[Tau]\:03cc\[FinalSigma]\>\""}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", 
    "\"\<\[CapitalEta] \[Alpha]\[Kappa]\[Rho]\[Iota]\[Beta]\:03ae \[Lambda]\
\:03cd\[Sigma]\[Eta]:\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Solution", "[", 
