Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"L", ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["T", "1"], ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["T", "2"], ":=", "2"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    SubscriptBox["T", "1"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       SuperscriptBox["x", "2"], 
       SuperscriptBox["L", "2"]]}], ")"}]}], "+", 
   FractionBox[
    RowBox[{
     SubscriptBox["T", "2"], "x"}], "L"]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "[", "x_", "]"}], ":=", 
  RowBox[{
   SubscriptBox["T", "1"], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["T", "2"], "-", 
       SubscriptBox["T", "1"]}], ")"}], "x"}], 
    "L"]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<\[CapitalGamma]\[Iota]\[Alpha] t->\[Infinity] \[Eta] \[Lambda]\:03cd\
\[Sigma]\[Eta] \[Pi]\[Rho]\[Omicron]\[Sigma]\[CurlyEpsilon]\[Gamma]\[Gamma]\
\:03af\[Zeta]\[CurlyEpsilon]\[Iota] \
\[Alpha]\[Sigma]\[Upsilon]\[Mu]\[Pi]\[Tau]\[Omega]\[Tau]\[Iota]\[Kappa]\:03ac \
\[Tau]\[Eta]\[Nu] \[Sigma]\[Upsilon]\[Nu]\:03ac\[Rho]\[Tau]\[Eta]\[Sigma]\
\[Eta]: \>\"", ",", 
   RowBox[{"S", "[", "x", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pde", "=", "  ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"U", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "\[Equal]", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"U", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bc1", "=", 
   RowBox[{
    RowBox[{"U", "[", 
     RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
    SubscriptBox["T", "1"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bc2", "=", 
   RowBox[{
    RowBox[{"U", "[", 
     RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", 
    SubscriptBox["T", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ic", "=", 
   RowBox[{
    RowBox[{"U", "[", 
     RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
    RowBox[{"f", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nsol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", "bc1", ",", "bc2", ",", "ic"}], "}"}], ",", 
     RowBox[{"{", "U", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"MaxStepSize", "\[Rule]", "10000"}], ",", 
     RowBox[{"MaxSteps", "\[Rule]", "10000"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "=", 
    RowBox[{"nsol", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot3D", "[", " ", 
   RowBox[{
    RowBox[{"z", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "0.5"}], "}"}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "t", ",", "\"\<z\>\""}], "}"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"ColorFunction", "\[Rule]", "\"\<TemperatureMap\>\""}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"Directive", "[", 
      RowBox[{"Blue", ",", 
       RowBox[{"FontWeight", "\[Rule]", "Bold"}], ",", 
       RowBox[{"FontSize", "\[Rule]", "12"}], ",", 
       RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}]}], "]"}]}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"z", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
