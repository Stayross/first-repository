 CellChangeTimes->{{3.6576589997474127`*^9, 3.657659002234568*^9}, 
   3.6590115211582813`*^9, 3.6661181855788774`*^9, 3.6689783687030396`*^9}],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psum", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "[", "n", "]"}], " ", 
      RowBox[{"r", "^", "n"}], "  ", 
      RowBox[{"LegendreP", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "m"}], "}"}]}], "]"}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "n_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "n"}], "+", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"a", "^", "n"}]}], ")"}]}], "*", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"LegendreP", "[", 
        RowBox[{"n", ",", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], " ", "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]", " ", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}]}], "]"}]}]}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "1"}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "\[Theta]_", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}], ")"}], "^", "2"}], "+", "2"}]}],
    ";"}], "  ", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Solution", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"psum", "[", 
     RowBox[{"r", ",", "\[Theta]", ",", "10"}], "]"}], "//", 
    "TraditionalForm"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<\[CapitalEta] \[Lambda]\:03cd\[Sigma]\[Eta] u(r,\[Theta]) = \>\"", 
    ",", 
    RowBox[{"Solution", "[", 
     RowBox[{"r", ",", "\[Theta]"}], "]"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"Solution", "[", 
       RowBox[{"r", ",", "\[Theta]"}], "]"}], " ", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"1", "/", "4"}], ",", 
       RowBox[{"3", "/", "4"}], ",", 
       RowBox[{"1", "/", "4"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]", ",", 
       RowBox[{"\[Pi]", "/", "4"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"TableHeadings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\"\<u(\!\(\*FractionBox[\(1\), \(4\)]\),\[Theta])\>\"", ",", 
        "\"\<u(\!\(\*FractionBox[\(1\), \(2\)]\),\[Theta])\>\"", ",", 
        "\"\<u(\!\(\*FractionBox[\(3\), \(4\)]\),\[Theta])\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<0\>\"", ",", "\"\<\!\(\*FractionBox[\(\[Pi]\), \(4\)]\)\>\"", 
        ",", "\"\<\!\(\*FractionBox[\(\[Pi]\), \(2\)]\)\>\"", ",", 
        "\"\<\!\(\*FractionBox[\(3  \[Pi]\), \(4\)]\)\>\"", ",", 
        "\"\<\[Pi]\>\""}], "}"}]}], "}"}]}], ",", 
   RowBox[{"TableAlignments", "\[Rule]", "Center"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10003.},
