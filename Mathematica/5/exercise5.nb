Cell[CellGroupData[{

Cell["\[Gamma])", "Text",
 CellGroupingRules->{GroupTogetherGrouping, 10005.},
 CellChangeTimes->{{3.668674044608339*^9, 3.6686740581722393`*^9}}],

Cell[BoxData[{
 RowBox[{"L", ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["T", "1"], ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["T", "2"], ":=", "2"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["T", "1"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        SuperscriptBox["x", "2"], 
        SuperscriptBox["L", "2"]]}], ")"}]}], "+", 
    FractionBox[
     RowBox[{
      SubscriptBox["T", "2"], "x"}], "L"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", "x_", "]"}], "=", 
   RowBox[{
    SubscriptBox["T", "1"], "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["T", "2"], "-", 
        SubscriptBox["T", "1"]}], ")"}], "x"}], "L"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Solution", "[", 
    RowBox[{"x_", ",", "t_", ",", "N_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"S", "[", "x", "]"}], "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"c", "[", "n", "]"}], "*", 
       RowBox[{"Sin", "[", 
        FractionBox[
         RowBox[{"n", "*", "Pi", "*", "x"}], "L"], "]"}], "*", 
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            SuperscriptBox["n", "2"], 
            SuperscriptBox["Pi", "2"], "t"}], 
           SuperscriptBox["L", "2"]]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "N"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"c", "[", "n_", "]"}], "=", 
    RowBox[{
     FractionBox["2", "L"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "L"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], "-", 
         RowBox[{"S", "[", "x", "]"}]}], ")"}], "*", 
       RowBox[{"Sin", "[", 
        FractionBox[
         RowBox[{"n", "*", "Pi", "*", "x"}], "L"], "]"}], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sol", "[", 
     RowBox[{"x_", ",", "t_"}], "]"}], "=", 
    RowBox[{"Solution", "[", 
     RowBox[{"x", ",", "t", ",", "20"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Sol", "[", 
    RowBox[{"x", ",", "t"}], "]"}], " ", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t", ",", "\"\<z\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"ColorFunction", "\[Rule]", "\"\<TemperatureMap\>\""}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{"Blue", ",", 
      RowBox[{"FontWeight", "\[Rule]", "Bold"}], ",", 
      RowBox[{"FontSize", "\[Rule]", "12"}], ",", 
      RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}]}], "]"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "500"}]}], "]"}]}], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10005.},
 CellChangeTimes->{{3.6686740307974215`*^9, 3.6686740581732397`*^9}}],

