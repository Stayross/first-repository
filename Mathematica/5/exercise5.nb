Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"L", ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["T", "1"], ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["T", "2"], ":=", "2"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "[", "x_", "]"}], ":=", 
  RowBox[{
   SubscriptBox["T", "1"], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["T", "2"], "-", 
       SubscriptBox["T", "1"]}], ")"}], "x"}], 
    "L"]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<\[CapitalGamma]\[Iota]\[Alpha] t->\[Infinity] \[Eta] \[Lambda]\:03cd\
