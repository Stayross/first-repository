 InterpretationBox[
  RowBox[{"\<\"\[CapitalAlpha]\[Nu]\[Tau]\[Iota]\[Sigma]\[Tau]\[Rho]\:03ad\
\[CurlyPhi]\[Omicron]\[Nu]\[Tau]\[Alpha]\[FinalSigma] \[Tau]\[Omicron]\[Nu] \
\[Mu]\[CurlyEpsilon]\[Tau]\[Alpha]\[Sigma]\[Chi]\[Eta]\[Mu]\[Alpha]\[Tau]\
\[Iota]\[Sigma]\[Mu]\:03cc \[Beta]\[Rho]\:03af\[Sigma]\[Kappa]\[Omicron]\
\[Upsilon]\[Mu]\[CurlyEpsilon] \[Tau]\[Eta]\[Nu] \
\[Lambda]\:03cd\[Sigma]\[Eta] u(x,t)= \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"a", "-", "x"}], ")"}], "2"], 
        RowBox[{"4", " ", "t"}]]}]], "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"a", "+", "x"}], ")"}], "2"], 
        RowBox[{"4", " ", "t"}]]}]]}], 
    RowBox[{"2", " ", 
     SqrtBox["\[Pi]"], " ", 
     SqrtBox["t"]}]]}],
  SequenceForm[
  "\[CapitalAlpha]\[Nu]\[Tau]\[Iota]\[Sigma]\[Tau]\[Rho]\:03ad\[CurlyPhi]\
\[Omicron]\[Nu]\[Tau]\[Alpha]\[FinalSigma] \[Tau]\[Omicron]\[Nu] \[Mu]\
\[CurlyEpsilon]\[Tau]\[Alpha]\[Sigma]\[Chi]\[Eta]\[Mu]\[Alpha]\[Tau]\[Iota]\
\[Sigma]\[Mu]\:03cc \[Beta]\[Rho]\:03af\[Sigma]\[Kappa]\[Omicron]\[Upsilon]\
\[Mu]\[CurlyEpsilon] \[Tau]\[Eta]\[Nu] \[Lambda]\:03cd\[Sigma]\[Eta] u(x,t)= \
", Rational[1, 2] (
    E^(Rational[-1, 
        4] $CellContext`t^(-1) ($CellContext`a - $CellContext`x)^2) - 
    E^(Rational[-1, 
       4] $CellContext`t^(-1) ($CellContext`a + $CellContext`x)^2)) 
   Pi^Rational[-1, 2] $CellContext`t^Rational[-1, 2]],
  Editable->False]], "Print",
