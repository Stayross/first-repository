    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False], TraditionalForm]]],
 " \:03ad\[Chi]\[Omicron]\[Upsilon]\[Mu]\[CurlyEpsilon]:\n\[CapitalIota]\
\[Omicron] =",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], 
    RowBox[{"+", "\[Infinity]"}]], TraditionalForm]]],
 "f(x) dx=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "L"}], 
      RowBox[{"+", "L"}]], "Tdx"}], "=", 
    RowBox[{"2", " ", "L", " ", "T"}]}], TraditionalForm]]],
 "  \[CurlyEpsilon]\[Pi]\[Omicron]\[Mu]\:03ad\[Nu]\[Omega]\[FinalSigma] \
\[Iota]\[Sigma]\[Chi]\:03cd\[CurlyEpsilon]\[Iota] \:03cc\[Tau]\[Iota]:\nu(x, \
t) \[LessEqual] ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"L", " ", "T"}], 
    SqrtBox[
     RowBox[{"\[Pi]v", " ", "t"}]]], TraditionalForm]]]
}], "Text",
