Cell[TextData[{
 "\[CapitalEta] \[Gamma]\[CurlyEpsilon]\[Nu]\[Iota]\[Kappa]\:03ae \[Lambda]\
\:03cd\[Sigma]\[Eta] \[CurlyEpsilon]\:03af\[Nu]\[Alpha]\[Iota]  u(x,t) = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", 
     SqrtBox[
      RowBox[{"\[Pi]v", " ", "t"}]]}]], TraditionalForm]]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], 
     RowBox[{"+", "\[Infinity]"}]], 
    RowBox[{
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "y"}], ")"}], "2"], 
         RowBox[{"4", "vt"}]]}]], "\[CenterDot]", 
      RowBox[{"f", "(", "y", ")"}]}], "dy"}]}], TraditionalForm]]],
 "\n\n\[CapitalGamma]\[Iota]\[Alpha] \[Nu]\[Alpha] \[CurlyEpsilon]\[Kappa]\
\[CurlyPhi]\[Rho]\:03ac\[Sigma]\[Omicron]\[Upsilon]\[Mu]\[CurlyEpsilon] \
\[Tau]\[Eta]\[Nu] \[Lambda]\:03cd\[Sigma]\[Eta] \[Mu]\[CurlyEpsilon] \[Tau]\
\[Eta]\[Nu] \[Beta]\[Omicron]\:03ae\[Theta]\[CurlyEpsilon]\[Iota]\[Alpha] \
\[Tau]\[Eta]\[FinalSigma] \[Sigma]\[Upsilon]\[Nu]\:03ac\[Rho]\[Tau]\[Eta]\
\[Sigma]\[Eta]\[FinalSigma] erf(x)\n\n\[RightPointer] \[CapitalChi]\[Omega]\
\[Rho]\:03af\[Zeta]\[Omicron]\[Upsilon]\[Mu]\[CurlyEpsilon] \[Tau]\[Omicron] \
\[Delta]\[Iota]\:03ac\[Sigma]\[Tau]\[Eta]\[Mu]\[Alpha] \[Omicron]\[Lambda]\
\[Omicron]\[Kappa]\[Lambda]\:03ae\[Rho]\[Omega]\[Sigma]\[Eta]\[FinalSigma] \
\[Sigma]\[CurlyEpsilon] (-\[Infinity],-L) U (-L,L) U (L,+\[Infinity])\
\[LineSeparator]\n\[RightPointer] \[CapitalChi]\[Rho]\[Eta]\[Sigma]\[Iota]\
\[Mu]\[Omicron]\[Pi]\[Omicron]\[Iota]\[Omicron]\:03cd\[Mu]\[CurlyEpsilon] \
\[Tau]\[Eta]\[Nu] \[Alpha]\[Lambda]\[Lambda]\[Alpha]\[Gamma]\:03ae \[Mu]\
\[CurlyEpsilon]\[Tau]\[Alpha]\[Beta]\[Lambda]\[Eta]\[Tau]\:03ae\[FinalSigma] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    FractionBox[
     RowBox[{"x", "-", "y"}], 
     RowBox[{"2", " ", 
      SqrtBox[
       RowBox[{"v", " ", "t"}]]}]]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " .\[LineSeparator]\n\[CapitalEpsilon]\[Kappa]\[Tau]\[CurlyEpsilon]\[Lambda]\
\:03cc\[Nu]\[Tau]\[Alpha]\[FinalSigma] \[Tau]\[Alpha] \[Pi]\[Alpha]\[Rho]\
\[Alpha]\[Pi]\:03ac\[Nu]\[Omega] \
\[Beta]\[Rho]\:03af\[Sigma]\[Kappa]\[Omicron]\[Upsilon]\[Mu]\[CurlyEpsilon] \
\:03cc\[Tau]\[Iota]:\n\nu(x,t) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[CapitalTau]", "2"], " ", 
    RowBox[{"(", "  ", 
     RowBox[{"erf", "(", 
      FractionBox[
       RowBox[{"x", "+", "L"}], 
       RowBox[{"2", 
        SqrtBox[
         RowBox[{"v", " ", "t"}]]}]], ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " - ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"erf", "(", 
      FractionBox[
       RowBox[{"x", "-", "L"}], 
       RowBox[{"2", 
        SqrtBox[
         RowBox[{"v", " ", "t"}]]}]], ")"}], "  ", ")"}], " "}], 
   TraditionalForm]]]
}], "Text",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{{3.6730338116263847`*^9, 3.6730338635736156`*^9}, {
  3.673033894662549*^9, 3.6730339594875813`*^9}, {3.673033992680646*^9, 
  3.673034309357342*^9}, {3.6730343516069694`*^9, 3.6730344266046343`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x_", ",", "t_", ",", "v_", ",", "L_", ",", "T_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "+", "L"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"v", "*", "t"}], "]"}]}], ")"}]}], "]"}], "-", 
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", "L"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"v", "*", "t"}], "]"}]}], ")"}]}], "]"}]}], ")"}], "*", 
     RowBox[{"T", "/", "2"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t", ",", "1", ",", "2", ",", "2"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
