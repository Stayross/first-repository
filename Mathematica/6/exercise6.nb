Cell[TextData[{
 "\[CapitalIota]\[Sigma]\[Chi]\:03cd\[CurlyEpsilon]\[Iota] \
\:03cc\[Tau]\[Iota] u(x, t) \[LessEqual] ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[CapitalIota]\[Omicron]", 
    RowBox[{"2", 
     SqrtBox[
      RowBox[{"\[Pi]v", " ", "t"}]]}]], TraditionalForm]]],
 ",   \[Gamma]\[Iota]\[Alpha]  t > 0  \n\[Mu]\[CurlyEpsilon] \[CapitalIota]\
\[Omicron] \[Tau]\[Eta]\[Nu] \[Omicron]\[Lambda]\[Iota]\[Kappa]\:03ae \
\[Alpha]\[Rho]\[Chi]\[Iota]\[Kappa]\:03ae \[Theta]\[CurlyEpsilon]\[Rho]\[Mu]\
\[Omicron]\[Kappa]\[Rho]\[Alpha]\[Sigma]\[Iota]\[Alpha]\[Kappa]\:03ae \[Pi]\
\[Omicron]\[Sigma]\:03cc\[Tau]\[Eta]\[Tau]\[Alpha] \[Tau]\[Omicron]\[Upsilon] \
\[Sigma]\:03ce\[Mu]\[Alpha]\[Tau]\[Omicron]\[FinalSigma] \[CapitalIota]\
\[Omicron] =",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], 
    RowBox[{"+", "\[Infinity]"}]], TraditionalForm]]],
 "f(x) dx  \n\[CapitalGamma]\[Iota]\[Alpha] \[Tau]\[Eta]\[Nu] \[Sigma]\
\[Upsilon]\[Nu]\:03ac\[Rho]\[Tau]\[Eta]\[Sigma]\[Eta] f(x)=",
 Cell[BoxData[
  FormBox[
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {"T", 
          RowBox[{"|", "x", "|", 
           RowBox[{"\[LessEqual]", " ", "L"}]}]},
         {"0", 
          RowBox[{"|", "x", "|", " ", 
           RowBox[{">", " ", "L"}]}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
