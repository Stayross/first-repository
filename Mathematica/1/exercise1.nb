 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"r_", ",", "a_", ",", "T_"}], "]"}], ":=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"r", "*", 
         RowBox[{"x", "[", "t", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"x", "[", "t", "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "a"}]}], "}"}], ",", "x", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "T"}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "\[Rule]", "$MachinePrecision"}], ",", 
     RowBox[{"PrecisionGoal", "\[Rule]", "$MachinePrecision"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
