     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"p15", "[", "x", "]"}], ",", 
     RowBox[{"p10", "[", "x", "]"}], ",", 
     RowBox[{"p5", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "2"}], "*", "Pi"}], ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e15", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], "-", 
      RowBox[{"p15", "[", "x", "]"}]}], "]"}], "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e10", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], "-", 
      RowBox[{"p10", "[", "x", "]"}]}], "]"}], "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e5", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], "-", 
      RowBox[{"p5", "[", "x", "]"}]}], "]"}], "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
