 CellChangeTimes->{{3.6545347646848993`*^9, 3.6545347671470613`*^9}}],

Cell["\<\
\[CapitalEta] \[Lambda]\:03cd\[Sigma]\[Eta] \[Tau]\[Omicron]\[Upsilon] \
\[Sigma]\[Upsilon]\[Sigma]\[Tau]\:03ae\[Mu]\[Alpha]\[Tau]\[Omicron]\
\[FinalSigma] \[Chi]\[Rho]\[Eta]\[Sigma]\[Iota]\[Mu]\[Omicron]\[Pi]\[Omicron]\
\[Iota]\:03ce\[Nu]\[Tau]\[Alpha]\[FinalSigma] \[Tau]\[Omicron]\[Nu] \[Tau]\
\:03cd\[Pi]\[Omicron] S(t)=e^At S(0) :\
\>", "Text",
 CellChangeTimes->{{3.6545471007240906`*^9, 3.6545471573798075`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "1", "1"},
      {"1", "0", "1"},
      {"1", "1", "0"}
     }], "\[NoBreak]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S0", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{"t", "*", "A"}], "]"}], ".", "S0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"S", "[", "t", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.654546798652276*^9, 3.6545468863770304`*^9}, {
  3.654547035477811*^9, 3.6545470852070727`*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "3"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", "t"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"3", " ", "t"}]]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["2", "3"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", "t"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "t"}]]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "3"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", "t"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"3", " ", "t"}]]}]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.6545468830768137`*^9, 3.654546887265089*^9}, {
  3.6545470608454747`*^9, 3.654547085849115*^9}}]
}, Open  ]],

Cell[TextData[StyleBox["\n\n\[CurlyEpsilon]\[Rho]\:03ce\[Tau]\[Eta]\[Mu]\
\[Alpha] \[Beta])",
 FontSize->18,
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.654539769393187*^9, 3.654539772424386*^9}, {
  3.6545449322428474`*^9, 3.6545449481398907`*^9}, {3.6545462995065346`*^9, 
  3.654546315285569*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"i", ",", "j"}], "]"}], "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "8"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "A", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"Eigenvalues", "[", "A", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"Max", "[", "B", "]"}], ",", "15"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{
