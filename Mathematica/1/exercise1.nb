Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"a_", ",", "T_"}], "]"}], ":=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], "^", "5"}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "\[Equal]", "a"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
    "x", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s1", "=", 
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "25"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s2", "=", 
   RowBox[{"f", "[", 
    RowBox[{"2", ",", "25"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s3", "=", 
   RowBox[{"f", "[", 
    RowBox[{"0.8", ",", "30"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s4", "=", 
   RowBox[{"f", "[", 
    RowBox[{"1.6", ",", "30"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", "s1"}], ",", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", "s2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "25"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", "s3"}], ",", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", "s4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "30"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.655053157909162*^9, 3.6550531592962527`*^9}, {
