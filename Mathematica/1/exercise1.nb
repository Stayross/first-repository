 FractionBox["4.206546315976363`", 
  SuperscriptBox["a", "2"]]], "Output",
 CellChangeTimes->{
  3.655064351664424*^9, {3.655064394729249*^9, 3.655064441596323*^9}}],

Cell["\[CapitalGamma]\[Iota]\[Alpha] \[Tau]\[Eta]\[Nu] \[CurlyEpsilon]\[Pi]\
\:03af\[Delta]\[Rho]\[Alpha]\[Sigma]\[Eta] \[Tau]\[Eta]\[FinalSigma] \[Tau]\
\[Rho]\[Iota]\[Beta]\:03ae\[FinalSigma]:", "Text",
 CellChangeTimes->{{3.6550576466566043`*^9, 3.6550576565282516`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"a_", ",", "c_", ",", "T_"}], "]"}], ":=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], "^", "5"}]}], "-", 
        RowBox[{"c", "*", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}]}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "\[Equal]", "a"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
    "x", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s5", "=", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "/.", 
    RowBox[{"g", "[", 
     RowBox[{"0.9", ",", "0.02", ",", "600"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{"s5", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "600"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.6550576771966076`*^9, 3.655057850608983*^9}, {
  3.655057887050373*^9, 3.655057977692319*^9}},
 FontWeight->"Plain"],

Cell["\<\
\[CapitalPi]\[Alpha]\[Rho]\[Alpha]\[Tau]\[Eta]\[Rho]\[Omicron]\:03cd\[Mu]\
\[CurlyEpsilon] \:03cc\[Tau]\[Iota] \[Eta] \[CurlyEpsilon]\[Pi]\:03af\[Delta]\
\[Rho]\[Alpha]\[Sigma]\[Eta] \[Tau]\[Eta]\[FinalSigma] \[Tau]\[Rho]\[Iota]\
\[Beta]\:03ae\[FinalSigma] \[Mu]\[CurlyEpsilon]\[Iota]\:03ce\[Nu]\
\[CurlyEpsilon]\[Iota] \[Tau]\[Omicron] \[Pi]\[Lambda]\:03ac\[Tau]\[Omicron]\
\[FinalSigma] \[Alpha] \[Kappa]\[Alpha]\[Tau]\:03ac \[Sigma]\[Upsilon]\[Nu]\
\:03ad\[Pi]\[CurlyEpsilon]\[Iota]\[Alpha] \[Alpha]\[Upsilon]\[Xi]\:03ac\[Nu]\
\[CurlyEpsilon]\[Tau]\[Alpha]\[Iota] \[Eta] \[Pi]\[CurlyEpsilon]\[Rho]\:03af\
\[Omicron]\[Delta]\[Omicron]\[FinalSigma] \[CapitalTau].\
\>", "Text",
 CellChangeTimes->{{3.655058088981619*^9, 3.65505813655474*^9}}],

