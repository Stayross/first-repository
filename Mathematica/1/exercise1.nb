Cell["\<\
\[CapitalTheta]\[Alpha] \[Beta]\[Rho]\[Omicron]\:03cd\[Mu]\[CurlyEpsilon] \
\[Tau]\[Eta]\[Nu] \[Sigma]\[Chi]\:03ad\[Sigma]\[Eta] \[Mu]\[CurlyEpsilon]\
\[Tau]\[Alpha]\[Xi]\:03cd \[Tau]\[Omicron]\[Upsilon] \[CapitalTau] \[Kappa]\
\[Alpha]\[Iota] \[Tau]\[Omicron]\[Upsilon] \[Alpha] \[Mu]\:03ad\[Sigma]\
\[Omega] \[Tau]\[Eta]\[FinalSigma] \[Sigma]\[Chi]\:03ad\[Sigma]\[Eta]\
\[FinalSigma] (5) \[Sigma]\[CurlyEpsilon]\[Lambda].139:\
\>", "Text",
 CellChangeTimes->{{3.655057103896002*^9, 3.65505715219917*^9}, {
  3.6550573129177127`*^9, 3.6550573349271564`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalTau]", "[", "a_", "]"}], "=", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "6"}], ")"}], "*", 
             RowBox[{"a", "^", "6"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "6"}], ")"}], "*", 
             RowBox[{"x", "^", "6"}]}]}], ")"}]}], "]"}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "a"}], ",", "a"}], "}"}]}], "]"}], "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"\[CapitalTau]", "[", "a", "]"}], ",", 
   RowBox[{"a", ">", "0"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.6550564431416593`*^9, 3.655056548171549*^9}, {
   3.655056623098463*^9, 3.6550566297779016`*^9}, {3.6550566614379787`*^9, 
   3.6550567633036604`*^9}, {3.6550568216964903`*^9, 
   3.6550568284269323`*^9}, {3.6550568766420946`*^9, 3.655056925243283*^9}, {
   3.655056974312502*^9, 3.655056992709708*^9}, 3.6550570745530767`*^9, {
   3.65506434321387*^9, 3.655064347900177*^9}, {3.6550643911520147`*^9, 
   3.6550644389361486`*^9}}],

Cell["\<\
\[CapitalBeta]\[Rho]\:03af\[Sigma]\[Kappa]\[Omicron]\[Upsilon]\[Mu]\
\[CurlyEpsilon] \:03cc\[Tau]\[Iota] \[CapitalTau]=4.20655 / a^2 . \
\[CapitalOmicron]\[Pi]\:03cc\[Tau]\[CurlyEpsilon] \
\[CurlyEpsilon]\[Pi]\[Alpha]\[Lambda]\[Eta]\[Theta]\[CurlyEpsilon]\:03cd\
\[Omicron]\[Upsilon]\[Mu]\[CurlyEpsilon] \:03cc\[Tau]\[Iota] \[Omicron] \
\[Delta]\[Iota]\[Pi]\[Lambda]\[Alpha]\[Sigma]\[Iota]\[Alpha]\[Sigma]\[Mu]\
\:03cc\[FinalSigma] \[Tau]\[Omicron]\[Upsilon] \[Alpha] \[Omicron]\[Delta]\
\[Eta]\[Gamma]\[CurlyEpsilon]\:03af \[Sigma]\[CurlyEpsilon] \[Upsilon]\[Pi]\
\[Omicron]\[Tau]\[CurlyEpsilon]\[Tau]\[Rho]\[Alpha]\[Pi]\[Lambda]\[Alpha]\
\[Sigma]\[Iota]\[Alpha]\[Sigma]\[Mu]\:03cc \[Tau]\[Omicron]\[Upsilon] \
\[CapitalTau].\
\>", "Text",
 CellChangeTimes->{{3.6550644670169907`*^9, 3.65506447981083*^9}}],

