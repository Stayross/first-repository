Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{"x", "*", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "[", 
   RowBox[{"n_", ",", "L_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["2", "L"], "*", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "L"], 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "*", 
     RowBox[{"Sin", "[", 
      RowBox[{"n", "*", "\[Pi]", "*", 
       FractionBox["x", "L"]}], "]"}], 
