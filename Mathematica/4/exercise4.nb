Cell[CellGroupData[{

Cell["\[Gamma])", "Text",
 CellGroupingRules->{GroupTogetherGrouping, 10008.},
 CellChangeTimes->{3.6658596290125628`*^9, 3.6658619316119123`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"solution", "=", 
    RowBox[{"V", "/.", "\[InvisibleSpace]", 
     RowBox[{"First", "[", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[PartialD]", "t"], 
            RowBox[{"V", "[", 
             RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
           RowBox[{
            SubscriptBox["\[PartialD]", 
             RowBox[{"{", 
              RowBox[{"x", ",", "2"}], "}"}]], 
            RowBox[{"V", "[", 
             RowBox[{"x", ",", "t"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"V", "[", 
            RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
           RowBox[{"x", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", "x"}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{"V", "[", 
            RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{
           RowBox[{"V", "[", 
            RowBox[{"1", ",", "t"}], "]"}], "==", "0"}]}], "}"}], ",", 
        RowBox[{"{", "V", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
