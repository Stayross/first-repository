Cell[CellGroupData[{

Cell["\[Alpha])", "Text",
 CellGroupingRules->{GroupTogetherGrouping, 10006.},
 CellChangeTimes->{3.665853424094415*^9, 3.6658619095924745`*^9}],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"ListPlot", ",", 
    RowBox[{"Joined", "\[Rule]", "True"}]}], "]"}], ";", 
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"x", "*", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}], ";", 
  RowBox[{"nu", "=", "1"}], ";", 
  RowBox[{"nX", "=", "20"}], ";", 
  RowBox[{"nT", "=", "1000"}], ";", 
  RowBox[{"l", "=", "1"}], ";", 
  RowBox[{"tF", "=", "1"}], ";", 
  RowBox[{"h", "=", 
   RowBox[{"l", "/", "nX"}]}], ";", 
  RowBox[{"k", "=", 
   RowBox[{"tF", "/", "nT"}]}], ";", 
  RowBox[{"r", "=", 
   RowBox[{"N", "[", 
    RowBox[{"nu", "*", 
     RowBox[{"k", "/", 
      RowBox[{"h", "^", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"xN", "[", "i", "]"}], "=", 
     RowBox[{"i", "*", "h"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "nX"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"tN", "[", "j", "]"}], "=", 
     RowBox[{"j", "*", "k"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "nT"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ic", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"uN", "[", 
       RowBox[{"i", ",", "0"}], "]"}], "\[Rule]", 
      RowBox[{"f", "[", 
       RowBox[{"xN", "[", "i", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "nX"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bc", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"uN", "[", 
         RowBox[{"0", ",", "j"}], "]"}], "\[Rule]", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nT"}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"uN", "[", 
         RowBox[{"nX", ",", "j"}], "]"}], "\[Rule]", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nT"}], "}"}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ibc", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"ic", ",", "bc"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fd", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"2", "*", "r"}]}], ")"}], "*", 
     RowBox[{"uN", "[", 
      RowBox[{"i", ",", "j"}], "]"}]}], "+", 
    RowBox[{"r", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"uN", "[", 
        RowBox[{
         RowBox[{"i", "+", "1"}], ",", "j"}], "]"}], "+", 
       RowBox[{"uN", "[", 
        RowBox[{
         RowBox[{"i", "-", "1"}], ",", "j"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"uN", "[", 
       RowBox[{"i", ",", 
        RowBox[{"j", "+", "1"}]}], "]"}], "=", 
      RowBox[{
       RowBox[{"fd", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "/.", "ibc"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "nT"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"nX", "-", "1"}]}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plot1", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"xN", "[", "i", "]"}], ",", 
         RowBox[{
          RowBox[{"uN", "[", 
           RowBox[{"i", ",", "100"}], "]"}], "/.", "ibc"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nX"}], "}"}]}], "]"}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<u\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", "\"\<t = 0.1\>\"", "}"}]}], ",", 
