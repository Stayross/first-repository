Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Heat2", "=", 
    RowBox[{"V", "/.", "\[InvisibleSpace]", 
     RowBox[{"First", "[", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[PartialD]", "t"], 
            RowBox[{"V", "[", 
             RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
           RowBox[{
            RowBox[{"2", "*", 
             RowBox[{
              SubscriptBox["\[PartialD]", 
               RowBox[{"{", 
                RowBox[{"x", ",", "2"}], "}"}]], 
              RowBox[{"V", "[", 
               RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
            RowBox[{"V", "[", 
             RowBox[{"x", ",", "t"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"V", "[", 
            RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
           RowBox[{"1", "-", 
            RowBox[{"Cos", "[", 
             RowBox[{"2", "x"}], "]"}], "+", 
            RowBox[{"4", 
             RowBox[{"Cos", "[", 
              RowBox[{"3", "x"}], "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"V", "[", 
                RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}], "/.", 
             RowBox[{"x", "\[Rule]", "0"}]}], ")"}], "\[Equal]", "0"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"V", "[", 
                RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}], "/.", 
             RowBox[{"x", "\[Rule]", "Pi"}]}], ")"}], "==", "0"}]}], "}"}], 
        ",", 
        RowBox[{"{", "V", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
        RowBox[{"MaxStepSize", "\[Rule]", "10000"}], ",", 
        RowBox[{"MaxSteps", "\[Rule]", "10000"}]}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<To \[Gamma]\[Rho]\:03ac\[CurlyPhi]\[Eta]\[Mu]\[Alpha] \[Tau]\[Eta]\
\[FinalSigma] \[Lambda]\:03cd\[Sigma]\[Eta]\[FinalSigma] \[Pi]\[Omicron]\
\[Upsilon] \[Pi]\[Rho]\[Omicron]\[Kappa]\:03cd\[Pi]\[Tau]\[CurlyEpsilon]\
\[Iota] \[Alpha]\[Pi]\:03cc \[Tau]\[Eta]\[Nu] NDSolve: \>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fig1", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"Heat2", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ColorFunction", "\[Rule]", "\"\<RustTones\>\""}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    SuperscriptBox["E", "t"], "-", 
    RowBox[{
     SuperscriptBox["E", 
      RowBox[{"-", "t"}]], 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "x"}], "]"}]}], "+", 
    RowBox[{"4", 
     SuperscriptBox["E", 
      RowBox[{
       RowBox[{"-", "2"}], "t"}]], 
     RowBox[{"Cos", "[", 
      RowBox[{"3", " ", "x"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<To \[Gamma]\[Rho]\:03ac\[CurlyPhi]\[Eta]\[Mu]\[Alpha] \[Tau]\[Eta]\
\[FinalSigma] \[Lambda]\:03cd\[Sigma]\[Eta]\[FinalSigma] \[Pi]\[Omicron]\
\[Upsilon] \[Pi]\[Rho]\[Omicron]\[Kappa]\:03cd\[Pi]\[Tau]\[CurlyEpsilon]\
\[Iota] \[Alpha]\[Pi]\:03cc \[Tau]\[Omicron] \
\[CurlyEpsilon]\[Rho]\:03ce\[Tau]\[Eta]\[Mu]\[Alpha] \[Beta]): \>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fig2", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ColorFunction", "\[Rule]", "\"\<BlueGreenYellow\>\""}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<T\[Alpha] \[Gamma]\[Rho]\:03ac\[CurlyPhi]\[Eta]\[Mu]\[Alpha]\[Tau]\
\[Alpha] \[Tau]\[Omega]\[Nu] \[Delta]\:03cd\[Omicron] \[Lambda]\:03cd\[Sigma]\
\[CurlyEpsilon]\[Omega]\[Nu] \[Mu]\[Alpha]\[Zeta]\:03af: \>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"fig1", ",", "fig2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<\[CapitalPi]\[Alpha]\[Rho]\[Alpha]\[Tau]\[Eta]\[Rho]\[Omicron]\:03cd\
\[Mu]\[CurlyEpsilon] \:03cc\[Tau]\[Iota] \[Eta] \[Mu]\:03ad\[Theta]\[Omicron]\
\[Delta]\[Omicron]\[FinalSigma] NDSolve \[Delta]\:03af\[Nu]\[CurlyEpsilon]\
\[Iota] \[Alpha]\[Pi]\[Omicron]\[Tau]\[CurlyEpsilon]\[Lambda]\:03ad\[Sigma]\
\[Mu]\[Alpha]\[Tau]\[Alpha] \[Mu]\[CurlyEpsilon] \[Mu]\[CurlyEpsilon]\[Gamma]\
\:03ac\[Lambda]\[Eta] \[Alpha]\[Kappa]\[Rho]\:03af\[Beta]\[CurlyEpsilon]\
\[Iota]\[Alpha].\>\"", "]"}]}], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10006.},
 CellChangeTimes->{{3.666111043105505*^9, 3.6661110725514274`*^9}, {
  3.6661111072726946`*^9, 3.6661112950529556`*^9}, {3.6661113680117197`*^9, 
