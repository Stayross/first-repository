Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "[", 
   RowBox[{"n_", ",", "L_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["2", "L"], "*", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "L"], 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "*", 
     RowBox[{"Cos", "[", 
      RowBox[{"n", "*", "\[Pi]", "*", 
       FractionBox["x", "L"]}], "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c0", "[", "L_", "]"}], ":=", 
  RowBox[{
   FractionBox["1", "L"], "*", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "L"], 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "[", 
   RowBox[{"n_", ",", "L_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"n", "^", "2"}], "*", 
    RowBox[{"\[Pi]", "^", "2"}]}], 
   RowBox[{"L", "^", "2"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"U", "[", 
   RowBox[{"x_", ",", "t_", ",", "N_", ",", "L_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"c0", "[", "L", "]"}], "+", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "N"], 
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"n", ",", "L"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[Lambda]", "[", 
         RowBox[{"n", ",", "L"}], "]"}]}], "*", "t"}], "]"}], "*", 
     RowBox[{"Cos", "[", 
      RowBox[{"n", "*", "\[Pi]", "*", 
       FractionBox["x", "L"]}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{"x", 
     RowBox[{"(", 
      RowBox[{"Pi", "-", "x"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "x_", "]"}], "=", 
   RowBox[{"U", "[", 
    RowBox[{"x", ",", "0.1", ",", "10", ",", "Pi"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plot1", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"u", "[", "x", "]"}], ",", 
     RowBox[{"{", 
