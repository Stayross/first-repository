Cell[CellGroupData[{

Cell["\[Beta])", "Text",
 CellGroupingRules->{GroupTogetherGrouping, 10002.},
 CellChangeTimes->{3.66564493628907*^9, 3.6659122905448537`*^9}],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NormYn", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "x"}], "/", "2"}], "]"}], "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"n", "*", "x"}], "]"}]}], ")"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "Pi"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"n", "\[Element]", "Integers"}], "&&", " ", 
      RowBox[{"n", "\[GreaterEqual]", "1"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<\[LeftDoubleBracketingBar]\!\(\*SubscriptBox[\(Y\), \(n\)]\)\
\[RightDoubleBracketingBar] = \>\"", ",", "NormYn"}], "]"}]}], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10002.},
 CellChangeTimes->{{3.665648665597578*^9, 3.6656488189175897`*^9}, {
   3.665648850865676*^9, 3.6656488718600464`*^9}, {3.665648914766848*^9, 
   3.6656489261665926`*^9}, 3.665649164995187*^9, 3.665650429174732*^9, {
   3.6656529946902494`*^9, 3.665653002307747*^9}, {3.665653743460141*^9, 
   3.6656537964696026`*^9}, {3.665654535651868*^9, 3.6656545530150013`*^9}, {
   3.665774597449935*^9, 3.66577459874902*^9}, {3.665777121633754*^9, 
   3.6657771229498396`*^9}, {3.6657771810816355`*^9, 
   3.6657772264515977`*^9}, {3.665864762585763*^9, 3.665864774047511*^9}, 
   3.6658648805874677`*^9, {3.665911896464122*^9, 3.6659119751962624`*^9}, 
   3.6659122905448537`*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"\[LeftDoubleBracketingBar]\\!\\(\\*SubscriptBox[\\(Y\\), \
\\(n\\)]\\)\[RightDoubleBracketingBar] = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Pi]"}], "/", "2"}]], " ", 
     SqrtBox[
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["\[ExponentialE]", "\[Pi]"]}], ")"}]}]], " ", "n"}], 
    SqrtBox[
     RowBox[{"1", "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["n", "2"]}]}]]]}],
  SequenceForm[
