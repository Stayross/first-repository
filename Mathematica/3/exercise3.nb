Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sols", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"U", "''"}], "[", "x", "]"}], "  ", "\[Equal]", "  ", 
            RowBox[{
             RowBox[{"U", "[", "x", "]"}], "-", 
             RowBox[{
              RowBox[{"U", "[", "x", "]"}], "^", "3"}]}]}], ",", 
           RowBox[{
            RowBox[{"U", "[", "0", "]"}], " ", "\[Equal]", 
            RowBox[{"U", "[", "10", "]"}], " ", "\[Equal]", " ", "0"}]}], 
          "}"}], ",", "U", ",", "x", ",", " ", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<Shooting\>\"", ",", " ", 
            RowBox[{"\"\<StartingInitialConditions\>\"", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"U", "[", "0", "]"}], " ", "\[Equal]", " ", "0"}], 
               ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"U", "'"}], "[", "0", "]"}], " ", "\[Equal]", " ", 
                "#"}]}], "}"}]}]}], "}"}]}]}], "]"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graph1", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"U", "[", "x", "]"}], " ", "/.", " ", "sols"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<u'[0]=1\>\"", ",", "\"\<u'[0]=2\>\"", ",", "\"\<u'[0]=3\>\""}], 
      "}"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "}"}]}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "u"}], "}"}]}], ",", " ", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Black", ",", " ", "Blue", ",", " ", "Green", ",", "Red"}], 
      "}"}]}], ",", 
    RowBox[{"ImageSize", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"600", ",", "400"}], "}"}]}]}], "]"}]}]}], "Input",
