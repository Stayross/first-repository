Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SolveFunction", "[", "syntelestis_", "]"}], ":=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SetOptions", "[", 
      RowBox[{"ListPlot", ",", 
       RowBox[{"Joined", "\[Rule]", "True"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "x_", "]"}], ":=", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", "*", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nu", "=", "syntelestis"}], ",", 
       RowBox[{"nX", "=", "20"}], ",", 
       RowBox[{"nT", "=", "800"}], ",", 
       RowBox[{"l", "=", "1"}], ",", 
       RowBox[{"tF", "=", "1"}], ",", 
       RowBox[{"h", "=", 
        RowBox[{"l", "/", "nX"}]}], ",", 
       RowBox[{"k", "=", 
        RowBox[{"tF", "/", "nT"}]}], ",", 
       RowBox[{"r", "=", 
        RowBox[{"N", "[", 
         RowBox[{"nu", "*", 
          RowBox[{"k", "/", 
           RowBox[{"h", "^", "2"}]}]}], "]"}]}]}], "}"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"xN", "[", "i", "]"}], "=", 
        RowBox[{"i", "*", "h"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nX"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"tN", "[", "j", "]"}], "=", 
        RowBox[{"j", "*", "k"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nT"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ic", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"uN", "[", 
          RowBox[{"i", ",", "0"}], "]"}], "\[Rule]", 
         RowBox[{"f", "[", 
          RowBox[{"xN", "[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "nX"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"bc", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"uN", "[", 
            RowBox[{"0", ",", "j"}], "]"}], "\[Rule]", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "nT"}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"uN", "[", 
            RowBox[{"nX", ",", "j"}], "]"}], "\[Rule]", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "nT"}], "}"}]}], "]"}]}], "}"}]}], ";",
      "\n", "\t", 
     RowBox[{"ibc", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{"ic", ",", "bc"}], "}"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"fd", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "*", "r"}]}], ")"}], "*", 
        RowBox[{"uN", "[", 
         RowBox[{"i", ",", "j"}], "]"}]}], "+", 
       RowBox[{"r", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"uN", "[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", "j"}], "]"}], "+", 
          RowBox[{"uN", "[", 
           RowBox[{
            RowBox[{"i", "-", "1"}], ",", "j"}], "]"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"uN", "[", 
         RowBox[{"i", ",", 
          RowBox[{"j", "+", "1"}]}], "]"}], "=", 
        RowBox[{
         RowBox[{"fd", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "/.", "ibc"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nT"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"nX", "-", "1"}]}], "}"}]}], "]"}], " ", ";", 
     "\[IndentingNewLine]", "\n", "     ", 
     RowBox[{"data", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xN", "[", "i", "]"}], ",", 
            RowBox[{"tN", "[", "j", "]"}], ",", 
            RowBox[{
             RowBox[{"uN", "[", 
              RowBox[{"i", ",", "j"}], "]"}], "/.", "ibc"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "nT"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "nX"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"interpolation3d", "=", 
      RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], 
    "\[IndentingNewLine]", "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PlotFunction", "[", "nu_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"interpolation3d", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"AxesLabel", "\[Rule]", 
