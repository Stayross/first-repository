Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Q", "[", 
    RowBox[{"x0_", ",", "y0_", ",", "h_", ",", "N_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", "0", "]"}], "=", "x0"}], ";", 
     RowBox[{
      RowBox[{"v", "[", "0", "]"}], "=", "y0"}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"n", "+", "1"}], "]"}], "=", 
          RowBox[{
           RowBox[{"u", "[", "n", "]"}], "+", 
           RowBox[{"h", " ", 
            RowBox[{"F", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"u", "[", "n", "]"}], "+", 
               RowBox[{
                RowBox[{"h", "/", "2"}], " ", 
                RowBox[{"F", "[", 
                 RowBox[{
                  RowBox[{"u", "[", "n", "]"}], ",", 
                  RowBox[{"v", "[", "n", "]"}]}], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"v", "[", "n", "]"}], "+", 
               RowBox[{
