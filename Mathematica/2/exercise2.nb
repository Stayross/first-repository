Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FAB", "[", 
    RowBox[{"x_", ",", "y_", ",", "A_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "x"}], "+", 
    RowBox[{"A", "*", "y"}], "+", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "*", "y"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GAB", "[", 
     RowBox[{"x_", ",", "y_", ",", "B_"}], "]"}], "=", 
    RowBox[{"B", "-", 
     RowBox[{"A", "*", "y"}], "-", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "*", "y"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FAB", "[", 
         RowBox[{"x", ",", "y", ",", "A"}], "]"}], "\[Equal]", "0"}], "&&", 
       RowBox[{
        RowBox[{"GAB", "[", 
         RowBox[{"x", ",", "y", ",", "B"}], "]"}], "\[Equal]", "0"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<\[CapitalTau]\[Omicron] \[Sigma]\[Eta]\[Mu]\[CurlyEpsilon]\:03af\
\[Omicron] \[Iota]\[Sigma]\[Omicron]\[Rho]\[Rho]\[Omicron]\[Pi]\:03af\[Alpha]\
\[FinalSigma] \[CurlyEpsilon]\:03af\[Nu]\[Alpha]\[Iota]:\>\"", ",", 
    RowBox[{"p", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{"MatrixForm", "[", 
